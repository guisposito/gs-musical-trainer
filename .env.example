# Guitar String Trainer - Environment Variables
# Copy this file to .env.local for local development

# --- NextAuth (Google login) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-e-g-openssl-rand-base64-32
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Supabase (attempts storage for mastery stats) ---
# Project URL: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon/public) key – opcional; o app usa só a service_role no servidor
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Secret (service_role) – usar no servidor (API routes); NÃO expor no client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: If deploying to production
# NEXTAUTH_URL=https://your-domain.com
